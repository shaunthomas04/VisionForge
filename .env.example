# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.1-flash-lite

# Unsplash image search — free key at https://developers.unsplash.com
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google Cloud Storage — create these two buckets in your GCP project
GCS_BUCKET_RAW=visionforge-raw
GCS_BUCKET_EXPORTS=visionforge-exports

# MongoDB Atlas — connection string used by the MCP server subprocess
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/visionforge
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/visionforge

# MongoDB Atlas MCP Server SSE URL — only needed for Cloud Run deployment
# Leave blank for local dev (ADK spawns the MCP server via npx automatically)
MONGODB_MCP_SERVER_URL=
